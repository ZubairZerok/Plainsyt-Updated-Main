# Copy to .env.local for local development. Never commit real secrets.
# Everything prefixed VITE_ is bundled into the PUBLIC website code, so only put public values here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Do NOT add API keys for OpenRouter/OpenAI/etc. here. Call such services from a server or edge function.
